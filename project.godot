; Engine configuration file.
; Godot 4.7 — HVH 2018 (CS:GO 2018 Hack vs Hack)

config_version=5

[application]
config/name="HVH 2018"
config/description="CS:GO 2018 HvH on de_mirage. Cheats are the game."
config/version="1.0.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
